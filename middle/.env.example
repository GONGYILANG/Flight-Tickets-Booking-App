# DeepSeek strict tool calling uses the beta base URL.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/beta
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOOL_ROUNDS=8

# Existing Node.js REST backend.
BACKEND_BASE_URL=http://localhost:3000
BACKEND_TIMEOUT_SECONDS=10

# Dates such as "tomorrow" are interpreted relative to this timezone.
MIDDLE_TIMEZONE=Asia/Singapore

# Comma-separated frontend origins allowed to call the middle layer.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# This implementation stores conversations in one process.
MAX_CHAT_SESSIONS=1000
CHAT_SESSION_TTL_SECONDS=3600
MAX_CACHED_REPLIES=50
